DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pulsegrid
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
